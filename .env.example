BAM_SECRET_KEY=replace-with-a-long-random-secret
BAM_DATA_ROOT=/home/data
BAM_SECURE_COOKIES=1
BAM_SESSION_HOURS=12
BAM_MAX_UPLOAD_MB=100
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Version 22 optional intelligence integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
BAM_VIN_DECODER_URL=https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVinValuesExtended/{vin}?format=json

# Version 23.1 Workshop Intelligence + eManualOnline
BAM_WORKSHOP_PROVIDER_NAME=eManualOnline
BAM_WORKSHOP_PORTAL_URL=https://www.emanualonline.com/cars/
BAM_LABOUR_RATE=145

# Version 23.1 Email Centre (optional shortcuts; no mailbox password stored)
BAM_EMAIL_ADDRESS=
BAM_EMAIL_WEBMAIL_URL=

# Version 24.2 VIN Intelligence
BAM_VIN_DATA_PROVIDER_NAME=NHTSA vPIC
